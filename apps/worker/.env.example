# Kafka
KAFKA_BROKERS="localhost:9092"

# SMTP (used to send the real emails for "email" actions).
# For a quick real test, Gmail works: host smtp.gmail.com, port 587,
# SMTP_USER = your gmail address, SMTP_PASS = a 16-char Google "App Password"
# (not your normal password - create one at https://myaccount.google.com/apppasswords).
# For local testing without sending real mail, use https://ethereal.email
# to get a free disposable inbox + SMTP credentials.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""    
SMTP_FROM="Zapier Clone <no-reply@example.com>"
